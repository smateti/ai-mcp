<!--
  server.xml — OpenLiberty configuration with Conjur-resolved variables

  The conjur-microprofile-lib sets System properties from CONJUR_SECRETS.
  Liberty's variable resolution picks these up via ${propName} syntax.

  Example CONJUR_SECRETS env var:
    db.url=acme/prod/products/payments/resources/dbs/orders-db/url,
    db.username=acme/prod/products/payments/resources/dbs/orders-db/username,
    db.password=acme/prod/products/payments/resources/dbs/orders-db/password,
    kafka.bootstrap.servers=acme/prod/products/payments/resources/kafka/main/bootstrap-servers,
    ...

  These become System properties: db.url, db.username, db.password, etc.
  Liberty resolves ${db.url} from System properties automatically.
-->
<server description="Orders API - Conjur-Integrated">

    <!-- Features -->
    <featureManager>
        <feature>microProfile-6.1</feature>
        <feature>jdbc-4.3</feature>
        <feature>jndi-1.0</feature>
        <feature>mpHealth-4.0</feature>
        <feature>mpConfig-3.1</feature>
        <feature>mpRestClient-3.0</feature>
        <feature>mpOpenAPI-3.1</feature>
        <feature>jsonb-3.0</feature>
        <feature>cdi-4.0</feature>
        <feature>restfulWS-3.1</feature>
        <feature>mpMetrics-5.1</feature>
    </featureManager>

    <!-- HTTP Endpoint -->
    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="9080"
                  httpsPort="9443" />

    <!-- ================================================================= -->
    <!-- DataSource — credentials from Conjur via System properties         -->
    <!--                                                                    -->
    <!-- ${db.url}, ${db.username}, ${db.password} are resolved from        -->
    <!-- Conjur secrets set as System properties by conjur-microprofile-lib -->
    <!-- ================================================================= -->
    <dataSource id="OrdersDS" jndiName="jdbc/ordersdb">
        <jdbcDriver libraryRef="db2Lib" />
        <properties.db2.jcc
            serverName="${db.url}"
            portNumber="${db.port}"
            databaseName="${db.databaseName}"
            user="${db.username}"
            password="${db.password}"
            sslConnection="true" />
        <connectionManager maxPoolSize="20"
                          minPoolSize="5"
                          connectionTimeout="30s"
                          maxIdleTime="10m" />
    </dataSource>

    <library id="db2Lib">
        <fileset dir="${shared.resource.dir}/db2" includes="*.jar" />
    </library>

    <!-- ================================================================= -->
    <!-- Kafka (MicroProfile Reactive Messaging / Kafka client)             -->
    <!--                                                                    -->
    <!-- These can be referenced in microprofile-config.properties or       -->
    <!-- injected via @ConfigProperty. The conjur-microprofile-lib          -->
    <!-- ConfigSource (ordinal 500) provides them automatically.            -->
    <!--                                                                    -->
    <!-- mp.messaging.connector.liberty-kafka.bootstrap.servers =           -->
    <!--   ${kafka.bootstrap.servers}                                       -->
    <!-- mp.messaging.connector.liberty-kafka.sasl.jaas.config =            -->
    <!--   constructed from ${kafka.sasl.username} + ${kafka.sasl.password} -->
    <!-- ================================================================= -->

    <!-- ================================================================= -->
    <!-- LDAP Registry (if needed for app-level auth)                       -->
    <!--                                                                    -->
    <!-- ${ldap.url}, ${ldap.bind-dn}, ${ldap.bind-password} from Conjur   -->
    <!-- ================================================================= -->
    <!--
