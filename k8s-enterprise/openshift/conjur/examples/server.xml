                  realm="AcmeCorp"
                  host="${ldap.url}"
                  port="636"
                  baseDN="${ldap.base-dn}"
                  bindDN="${ldap.bind-dn}"
                  bindPassword="${ldap.bind-password}"
                  sslEnabled="true"
                  ldapType="Custom">
        <idsFilters userFilter="(&amp;(uid=%v)(objectclass=person))"
                    groupFilter="(&amp;(cn=%v)(objectclass=groupOfNames))" />
    </ldapRegistry>
    -->

    <!-- ================================================================= -->
    <!-- SMTP (Liberty mail session)                                        -->
    <!--                                                                    -->
    <!-- ${smtp.host}, ${smtp.port}, ${smtp.username}, ${smtp.password}     -->
    <!-- ================================================================= -->
    <!--
    <mailSession id="acmeMail"
                 jndiName="mail/default"
                 host="${smtp.host}"
                 from="${smtp.from-address}"
                 mailSessionID="acmeMail"
                 user="${smtp.username}"
                 password="${smtp.password}"
                 transportProtocol="smtp">
        <property name="mail.smtp.port" value="${smtp.port}" />
        <property name="mail.smtp.auth" value="true" />
        <property name="mail.smtp.starttls.enable" value="true" />
    </mailSession>
    -->

    <!-- ================================================================= -->
    <!-- SSL / TLS Keystore                                                 -->
    <!--                                                                    -->
    <!-- ${certs.keystore-password}, ${certs.truststore-password}           -->
    <!-- ================================================================= -->
    <!--
    <ssl id="defaultSSLConfig"
         keyStoreRef="defaultKeyStore"
         trustStoreRef="defaultTrustStore" />

    <keyStore id="defaultKeyStore"
              location="${server.config.dir}/resources/security/key.p12"
              type="PKCS12"
              password="${certs.keystore-password}" />

    <keyStore id="defaultTrustStore"
              location="${server.config.dir}/resources/security/trust.p12"
              type="PKCS12"
              password="${certs.truststore-password}" />
    -->

    <!-- Application -->
    <webApplication id="orders-api"
                    location="orders-api.war"
                    contextRoot="/">
        <classloader apiTypeVisibility="+third-party" />
    </webApplication>

    <!-- MicroProfile Health / Metrics -->
    <mpMetrics authentication="false" />

</server>
