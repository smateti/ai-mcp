{
  "description": "Example: Onboard the entire 'payments' product to Conjur",
  "instructions": "Use these as a guide for the curl commands needed to onboard a product.",

  "step1_register_product": {
    "description": "Load product-template.yml into the product path",
    "command": "curl -sk -X POST 'https://$CONJUR_URL/policies/myConjurAccount/policy/acme%2Fprod%2Fproducts%2Fpayments' -H 'Authorization: Token token=\"$TOKEN\"' -d @product-template.yml"
  },

  "step2_register_databases": {
    "description": "Load DB resources for the product",
    "databases": [
      {
        "name": "orders-db",
        "policy_path": "acme/prod/products/payments/resources/dbs",
        "variables": {
          "url": "jdbc:db2://db2-prod.acme.com:50000/ORDERSDB",
          "username": "orders_svc",
          "password": "<from-vault>",
          "port": "50000",
          "database-name": "ORDERSDB",
          "driver-class": "com.ibm.db2.jcc.DB2Driver"
        }
      },
      {
        "name": "ledger-db",
        "policy_path": "acme/prod/products/payments/resources/dbs",
        "variables": {
          "url": "jdbc:db2://db2-prod.acme.com:50000/LEDGERDB",
          "username": "ledger_svc",
          "password": "<from-vault>",
          "port": "50000",
          "database-name": "LEDGERDB",
          "driver-class": "com.ibm.db2.jcc.DB2Driver"
        }
      }
    ]
  },

  "step3_register_kafka": {
    "description": "Load Kafka cluster for the product",
    "policy_path": "acme/prod/products/payments/resources/kafka",
    "variables": {
      "main/bootstrap-servers": "kafka-0.kafka.prod.svc:9093,kafka-1.kafka.prod.svc:9093,kafka-2.kafka.prod.svc:9093",
      "main/sasl-username": "payments-kafka-user",
      "main/sasl-password": "<from-vault>",
      "main/sasl-mechanism": "SCRAM-SHA-512",
      "main/security-protocol": "SASL_SSL",
      "main/keystore-password": "<from-vault>",
      "main/truststore-password": "<from-vault>",
      "main/schema-registry-url": "https://schema-registry.kafka.prod.svc:8081",
      "main/schema-registry-key": "payments-sr-key",
      "main/schema-registry-secret": "<from-vault>"
    }
  },

  "step4_register_api_keys": {
    "description": "Load external API keys for the product",
    "policy_path": "acme/prod/products/payments/resources/api",
    "variables": {
      "stripe/key": "sk_live_...",
      "stripe/secret": "<from-vault>",
      "stripe/webhook-secret": "whsec_..."
    }
  },

  "step5_register_app_hosts": {
    "description": "Register application hosts",
    "openshift_apps": {
      "policy_path": "acme/prod/products/payments/apps/openshift",
      "hosts": [
        {
          "id": "orders-api",
          "namespace": "apps",
          "serviceaccount": "orders-api-sa",
          "auth_method": "jwt"
        },
        {
          "id": "settlement-api",
          "namespace": "apps",
          "serviceaccount": "settlement-api-sa",
          "auth_method": "jwt"
        }
      ]
    },
    "batch_apps": {
      "policy_path": "acme/prod/products/payments/apps/batch",
      "hosts": [
        {
          "id": "settlement-job",
          "auth_method": "api-key",
          "note": "API key returned on host creation — store securely"
        }
      ]
    },
    "websphere_apps": {
      "policy_path": "acme/prod/products/payments/apps/websphere",
      "hosts": [
        {
          "id": "billing-monolith",
          "auth_method": "api-key",
          "note": "API key returned on host creation — store in tWAS credential store"
        }
      ]
    }
  },

  "step6_grant_access": {
    "description": "Load delegation-template.yml to grant app → resource access",
    "command": "curl -sk -X POST 'https://$CONJUR_URL/policies/myConjurAccount/policy/acme%2Fprod%2Fproducts%2Fpayments' -H 'Authorization: Token token=\"$TOKEN\"' -d @delegation-template.yml"
  },

  "step7_jwt_enrollment": {
    "description": "Enroll OpenShift hosts in JWT authenticator (load at root)",
    "command": "curl -sk -X POST 'https://$CONJUR_URL/policies/myConjurAccount/policy/root' -H 'Authorization: Token token=\"$TOKEN\"' -d @jwt-enrollment-template.yml"
  },

  "step8_set_secrets": {
    "description": "Set actual secret values for all variables",
    "example_commands": [
      "curl -sk -X POST 'https://$CONJUR_URL/secrets/myConjurAccount/variable/acme%2Fprod%2Fproducts%2Fpayments%2Fresources%2Fdbs%2Forders-db%2Fusername' -H 'Authorization: Token token=\"$TOKEN\"' -d 'orders_svc'",
      "curl -sk -X POST 'https://$CONJUR_URL/secrets/myConjurAccount/variable/acme%2Fprod%2Fproducts%2Fpayments%2Fresources%2Fdbs%2Forders-db%2Fpassword' -H 'Authorization: Token token=\"$TOKEN\"' -d 'S3cur3P@ssw0rd'",
      "curl -sk -X POST 'https://$CONJUR_URL/secrets/myConjurAccount/variable/acme%2Fprod%2Fproducts%2Fpayments%2Fresources%2Fkafka%2Fmain%2Fsasl-password' -H 'Authorization: Token token=\"$TOKEN\"' -d 'KafkaS3cret'"
    ]
  },

  "verification": {
    "check_resources": "curl -sk 'https://$CONJUR_URL/resources/myConjurAccount?search=payments' -H 'Authorization: Token token=\"$TOKEN\"'",
    "check_permissions": "curl -sk 'https://$CONJUR_URL/resources/myConjurAccount?acting_as=host:acme/prod/products/payments/apps/openshift/orders-api&kind=variable' -H 'Authorization: Token token=\"$TOKEN\"'"
  }
}
