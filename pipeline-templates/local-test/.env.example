# =============================================================================
# Local testing environment variables
# =============================================================================
# Copy this file to .env and fill in values.
# .env is git-ignored and should never be committed.
# =============================================================================

# ── Pipeline variables (same as what the UI passes to GitLab) ────────────────
APP_NAME=sample-hello
ENVIRONMENT=dev

# ── GitLab CI/CD predefined variables (mocked for local testing) ─────────────
CI_PIPELINE_ID=0
CI_PIPELINE_CREATED_AT=2024-01-01T00:00:00Z
CI_COMMIT_SHA=local
CI_REGISTRY=registry.example.com
CI_REGISTRY_IMAGE=registry.example.com/services
CI_REGISTRY_USER=local
CI_REGISTRY_PASSWORD=local

# ── Custom CI/CD variables ───────────────────────────────────────────────────
# These map to GitLab CI/CD file variables.  For local testing, the files
# are mounted from .secrets/ via docker-compose.yml.
# CA_BUNDLE and MAVEN_SETTINGS are set as file paths in docker-compose.yml.

# ── OpenShift / Helm variables ───────────────────────────────────────────────
OCP_API_URL=https://api.ocp.example.com:6443
OCP_TOKEN=mock-token
