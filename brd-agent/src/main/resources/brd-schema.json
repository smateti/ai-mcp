{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business Requirements Document",
  "description": "Full BRD extracted from FoxPro source code, conforming to brd-schema.md",
  "type": "object",
  "required": [
    "metadata", "purpose", "actors", "menu_structure",
    "functional_requirements", "ui_screens", "data_entities",
    "business_rules", "reference_data", "reports", "security",
    "integrations", "open_questions"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["source_files", "module_name", "extraction_date"],
      "additionalProperties": false,
      "properties": {
        "source_files": { "type": "array", "items": { "type": "string" } },
        "module_name": { "type": "string" },
        "extraction_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "purpose": { "type": "string" },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "menu_structure": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["menu", "items"],
        "additionalProperties": false,
        "properties": {
          "menu": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "command", "hot_key", "condition", "screen_ref", "source_trace"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string" },
                "command": { "type": "string" },
                "hot_key": { "type": ["string", "null"] },
                "condition": { "type": ["string", "null"] },
                "screen_ref": { "type": ["string", "null"] },
                "source_trace": {
                  "type": "object",
                  "required": ["file", "location"],
                  "additionalProperties": false,
                  "properties": {
                    "file": { "type": "string" },
                    "location": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "functional_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "title", "description", "trigger", "inputs",
          "outputs", "business_rules", "exception_paths", "source_trace"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^FR-\\d{3}$" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "trigger": { "type": "string" },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "required", "validation"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "validation": { "type": ["string", "null"] }
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "description"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "business_rules": { "type": "array", "items": { "type": "string" } },
          "exception_paths": { "type": "array", "items": { "type": "string" } },
          "source_trace": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "location", "snippet"],
              "additionalProperties": false,
              "properties": {
                "file": { "type": "string" },
                "location": { "type": "string" },
                "snippet": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "ui_screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "name", "purpose", "form_type", "form_class", "library_file",
          "modal", "fields_displayed", "user_actions", "controls",
          "child_screens", "navigation_to", "components", "source_trace"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^UI-\\d{3}$" },
          "name": { "type": "string" },
          "purpose": { "type": "string" },
          "form_type": { "type": ["string", "null"] },
          "form_class": { "type": ["string", "null"] },
          "library_file": { "type": ["string", "null"] },
          "modal": { "type": ["boolean", "null"] },
          "fields_displayed": { "type": "array", "items": { "type": "string" } },
          "user_actions": { "type": "array", "items": { "type": "string" } },
          "controls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "action", "program_called"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "action": { "type": "string" },
                "program_called": { "type": ["string", "null"] }
              }
            }
          },
          "child_screens": { "type": "array", "items": { "type": "string" } },
          "navigation_to": { "type": "array", "items": { "type": "string" } },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "class_file", "target_table"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "class_file": { "type": "string" },
                "target_table": { "type": "string" }
              }
            }
          },
          "source_trace": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "location"],
              "additionalProperties": false,
              "properties": {
                "file": { "type": "string" },
                "location": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "data_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "fields", "relationships", "sql_queries", "source_trace"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "required", "validation", "business_meaning"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "validation": { "type": ["string", "null"] },
                "business_meaning": { "type": "string" }
              }
            }
          },
          "relationships": { "type": "array", "items": { "type": "string" } },
          "sql_queries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["sql", "purpose"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": ["string", "null"] },
                "sql": { "type": "string" },
                "purpose": { "type": "string" }
              }
            }
          },
          "source_trace": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "location"],
              "additionalProperties": false,
              "properties": {
                "file": { "type": "string" },
                "location": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "business_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule", "rationale", "source_trace"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^BR-\\d{3}$" },
          "rule": { "type": "string" },
          "rationale": { "type": ["string", "null"] },
          "source_trace": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "location", "snippet"],
              "additionalProperties": false,
              "properties": {
                "file": { "type": "string" },
                "location": { "type": "string" },
                "snippet": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "reference_data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["table", "description", "categories", "source_trace"],
        "additionalProperties": false,
        "properties": {
          "table": { "type": "string" },
          "description": { "type": "string" },
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "description", "used_by"],
              "additionalProperties": false,
              "properties": {
                "code": { "type": "string" },
                "description": { "type": "string" },
                "used_by": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "source_trace": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "location"],
              "additionalProperties": false,
              "properties": {
                "file": { "type": "string" },
                "location": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "purpose", "data_source", "parameters", "output_options", "source_trace"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^RPT-\\d{3}$" },
          "name": { "type": "string" },
          "purpose": { "type": "string" },
          "data_source": { "type": "string" },
          "parameters": { "type": "array", "items": { "type": "string" } },
          "output_options": { "type": "array", "items": { "type": "string" } },
          "source_trace": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "location"],
              "additionalProperties": false,
              "properties": {
                "file": { "type": "string" },
                "location": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "required": ["authentication", "authorization_model", "access_checks", "source_trace"],
      "additionalProperties": false,
      "properties": {
        "authentication": { "type": ["string", "null"] },
        "authorization_model": { "type": ["string", "null"] },
        "access_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["resource", "check_expression", "description"],
            "additionalProperties": false,
            "properties": {
              "resource": { "type": "string" },
              "check_expression": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "source_trace": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "location"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string" },
              "location": { "type": "string" }
            }
          }
        }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "description", "source_trace"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "source_trace": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "location"],
              "additionalProperties": false,
              "properties": {
                "file": { "type": "string" },
                "location": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
