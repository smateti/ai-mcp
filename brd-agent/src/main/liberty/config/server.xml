<?xml version="1.0" encoding="UTF-8"?>
<server description="BRD Extraction Agent">

    <featureManager>
        <feature>microProfile-6.1</feature>
        <feature>beanValidation-3.0</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint"
                  httpPort="${default.http.port}"
                  httpsPort="${default.https.port}" />

    <webApplication location="brd-agent.war" contextRoot="/" />

    <!-- Logging: route all output through Liberty's console log -->
    <logging consoleLogLevel="INFO"
             consoleFormat="simple"
             traceSpecification="com.example.brdagent.*=fine" />

</server>
