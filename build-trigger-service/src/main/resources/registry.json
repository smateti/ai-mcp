{
  "order-management": {
    "type": "service",
    "services": ["order-api", "order-worker", "order-notifier"],
    "environments": ["dev", "staging", "prod"]
  },
  "inventory-system": {
    "type": "service",
    "services": ["inventory-api", "stock-sync"],
    "environments": ["dev", "staging", "prod"]
  },
  "sample-hello": {
    "type": "service",
    "services": ["hello-service"],
    "environments": ["dev", "staging", "prod"]
  },
  "nightly-etl": {
    "type": "batch",
    "services": ["etl-job"],
    "environments": ["dev", "prod"]
  },
  "report-generator": {
    "type": "batch",
    "services": ["report-job", "email-sender"],
    "environments": ["dev", "staging", "prod"]
  }
}
