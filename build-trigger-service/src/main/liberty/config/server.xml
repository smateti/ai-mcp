<?xml version="1.0" encoding="UTF-8"?>
<server description="Build Trigger Service">

    <!-- ── Features ─────────────────────────────────────────────────── -->
    <featureManager>
        <feature>microProfile-6.1</feature>
        <feature>persistence-3.1</feature>
        <feature>jdbc-4.2</feature>
    </featureManager>

    <!-- ── HTTP Endpoints ───────────────────────────────────────────── -->
    <httpEndpoint id="defaultHttpEndpoint"
                  httpPort="${default.http.port}"
                  httpsPort="${default.https.port}"
                  host="*" />

    <!-- ── Web Application ──────────────────────────────────────────── -->
    <webApplication location="build-trigger-service.war"
                    contextRoot="/">
        <classloader apiTypeVisibility="+third-party" />
    </webApplication>

    <!-- ── Embedded Derby datasource ────────────────────────────────── -->
    <!-- To switch to DB2: replace jdbcDriver, add DB2 properties,     -->
    <!-- update persistence.xml — no Java code changes required.        -->
    <library id="derbyLib">
        <fileset dir="${shared.resource.dir}/derby"
                 includes="derby*.jar" />
    </library>

    <dataSource id="BuildDS" jndiName="jdbc/buildDS">
        <jdbcDriver libraryRef="derbyLib" />
        <properties.derby.embedded
            databaseName="${server.output.dir}/databases/builddb"
            createDatabase="create" />
    </dataSource>

    <!-- ── MicroProfile Config ──────────────────────────────────────── -->
    <variable name="default.http.port"  defaultValue="9081" />
    <variable name="default.https.port" defaultValue="9444" />

    <!-- ── Logging ──────────────────────────────────────────────────── -->
    <logging consoleLogLevel="INFO"
            consoleFormat="simple" />

</server>
