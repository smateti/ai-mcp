{
  "$schema" : "http://json-schema.org/draft-07/schema#",
  "title" : "Order",
  "type" : "object",
  "properties" : {
    "orderId" : {
      "type" : "string",
      "description" : "Unique order identifier"
    },
    "orderDate" : {
      "type" : "string",
      "description" : "Date and time the order was placed"
    },
    "status" : {
      "type" : "string",
      "description" : "Current order status"
    },
    "totalAmount" : {
      "type" : "number",
      "description" : "Total order amount"
    },
    "customer" : {
      "type" : "object",
      "description" : "Customer who placed the order",
      "properties" : {
        "customerId" : {
          "type" : "string",
          "description" : "Unique customer identifier"
        },
        "name" : {
          "type" : "string",
          "description" : "Full name of the customer"
        },
        "email" : {
          "type" : "string",
          "description" : "Customer email address"
        },
        "phone" : {
          "type" : "string",
          "description" : "Customer phone number"
        }
      },
      "required" : [ "customerId", "name", "email" ]
    },
    "shippingAddress" : {
      "type" : "object",
      "description" : "A postal address",
      "properties" : {
        "street" : {
          "type" : "string",
          "description" : "Street address"
        },
        "city" : {
          "type" : "string",
          "description" : "City name"
        },
        "state" : {
          "type" : "string",
          "description" : "State or province"
        },
        "zipCode" : {
          "type" : "string",
          "description" : "ZIP or postal code"
        },
        "country" : {
          "type" : "string",
          "description" : "Country name"
        }
      },
      "required" : [ "street", "city", "country" ]
    },
    "billingAddress" : {
      "type" : "object",
      "description" : "A postal address",
      "properties" : {
        "street" : {
          "type" : "string",
          "description" : "Street address"
        },
        "city" : {
          "type" : "string",
          "description" : "City name"
        },
        "state" : {
          "type" : "string",
          "description" : "State or province"
        },
        "zipCode" : {
          "type" : "string",
          "description" : "ZIP or postal code"
        },
        "country" : {
          "type" : "string",
          "description" : "Country name"
        }
      },
      "required" : [ "street", "city", "country" ]
    },
    "items" : {
      "type" : "array",
      "description" : "List of items in the order",
      "items" : {
        "type" : "object",
        "properties" : {
          "productId" : {
            "type" : "string",
            "description" : "Product identifier"
          },
          "productName" : {
            "type" : "string",
            "description" : "Name of the product"
          },
          "quantity" : {
            "type" : "integer",
            "description" : "Quantity ordered"
          },
          "price" : {
            "type" : "number",
            "description" : "Price per unit"
          },
          "discount" : {
            "type" : "object",
            "description" : "Applied discount details",
            "properties" : {
              "code" : {
                "type" : "string",
                "description" : "Discount code"
              },
              "percentage" : {
                "type" : "number",
                "description" : "Discount percentage"
              }
            }
          }
        },
        "required" : [ "productId", "quantity", "price" ]
      }
    },
    "payment" : {
      "type" : "object",
      "description" : "Payment information",
      "properties" : {
        "method" : {
          "type" : "string",
          "description" : "Payment method used"
        },
        "transactionId" : {
          "type" : "string",
          "description" : "Payment transaction identifier"
        },
        "cardDetails" : {
          "type" : "object",
          "description" : "Credit/debit card details",
          "properties" : {
            "lastFourDigits" : {
              "type" : "string",
              "description" : "Last 4 digits of the card"
            },
            "cardType" : {
              "type" : "string",
              "description" : "Type of card (Visa, Mastercard, etc.)"
            },
            "expiryDate" : {
              "type" : "string",
              "description" : "Card expiry date"
            }
          }
        }
      },
      "required" : [ "method", "transactionId" ]
    }
  },
  "required" : [ "orderId", "customer", "items" ]
}